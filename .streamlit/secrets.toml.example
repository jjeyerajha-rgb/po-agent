# Copy to .streamlit/secrets.toml for local development (never commit secrets.toml).
# On Streamlit Cloud: App → Settings → Secrets → paste this format.

OPENAI_API_KEY = "sk-your-api-key-here"
OPENAI_MODEL = "gpt-4o"
# OPENAI_BASE_URL = "https://your-endpoint.openai.azure.com/"
MAX_TOKENS = "4096"
TEMPERATURE = "0.7"
